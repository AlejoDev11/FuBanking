{
  "name": "fubanking-serenity-e2e",
  "version": "1.0.0",
  "description": "Pruebas E2E de FuBanking basadas en el patron Screenplay con Serenity/JS, Playwright y Cucumber",
  "scripts": {
    "clean": "node scripts/clean.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run clean && cucumber-js",
    "test:loans": "npm test -- --tags \"@loans\"",
    "test:smoke": "npm test -- --tags \"@smoke\"",
    "test:report": "html-reporter serve --dir reports/serenity-js --port 8080 --open"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@serenity-js/assertions": "^3.48.0",
    "@serenity-js/console-reporter": "^3.48.0",
    "@serenity-js/core": "^3.48.0",
    "@serenity-js/cucumber": "^3.48.0",
    "@serenity-js/html-reporter": "^3.48.0",
    "@serenity-js/playwright": "^3.48.0",
    "@serenity-js/rest": "^3.48.0",
    "@serenity-js/web": "^3.48.0",
    "@types/node": "^24.10.0",
    "cross-env": "^10.1.0",
    "playwright": "^1.50.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  }
}
